#!/data/data/com.termux/files/usr/bin/python3
import sys
import os
import argparse
import json

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../src')))

from dealhunter.historico import analyze_history, compare_stores
from dealhunter.db import get_default_db_path
from dealhunter.output import print_results
from dealhunter.alerts import AlertEngine
from dealhunter.web.app import run_server

def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command")
    
    compare_p = subparsers.add_parser("compare")
    compare_p.add_argument("query")
    compare_p.add_argument("--exact-only", action="store_true")
    compare_p.add_argument("--no-fuzzy", action="store_true")
    
    deals_p = subparsers.add_parser("deals")
    deals_p.add_argument('--top', type=int, default=50)
    deals_p.add_argument('--store', type=str, default=None)
    deals_p.add_argument('--status', action='append', default=None)
    deals_p.add_argument('--format', choices=['table', 'json', 'csv', 'markdown'], default='table')
    deals_p.add_argument('--explain', action='store_true')
    deals_p.add_argument('--sort', choices=['discount', 'price'], default='discount')
    
    
    alerts_p = subparsers.add_parser("alerts")
    alerts_p.add_argument('action', nargs='?', choices=['list', 'evaluate', 'mark-seen'], default='list')
    alerts_p.add_argument('--top', type=int, default=50)
    alerts_p.add_argument('--store', type=str, default=None)
    alerts_p.add_argument('--type', type=str, default=None)
    alerts_p.add_argument('--new', action='store_true', help="Show only unseen alerts")
    alerts_p.add_argument('--format', choices=['table', 'json', 'csv', 'markdown'], default='table')
    
    
    web_p = subparsers.add_parser("web")
    web_p.add_argument('--port', type=int, default=8765)
    
    args, unknown = parser.parse_known_args()


    db_path = get_default_db_path()
    
    
    if args.command == "alerts":
        engine = AlertEngine(db_path)
        if args.action == "evaluate":
            res = engine.evaluate()
            print_results(res, format=args.format)
            return
        elif args.action == "mark-seen":
            engine.mark_seen(all=True)
            print("All alerts marked as seen.")
            return
        else: # list
            res = engine.get_alerts(new_only=args.new, top=args.top, store=args.store, alert_type=args.type)
            print_results(res, format=args.format)
            return

    
    if args.command == "web":
        print(f"DealHunter Web\nhttp://127.0.0.1:{args.port}")
        run_server(port=args.port)
        return

    if args.command == "compare":
        res = compare_stores(db_path, args.query, exact_only=args.exact_only, no_fuzzy=args.no_fuzzy)
        print_results(res, format="table")
        return
        
    if args.command == "deals" or args.command is None:
        # Fallback to defaults if no command is specified (backward compat)
        if args.command is None:
            args.top = 50
            args.store = None
            args.status = None
            args.format = 'table'
            args.explain = False
            args.sort = 'discount'
            
        config = {
            "status": args.status,
            "sort": args.sort,
        }
        
        res = analyze_history(db_path, config, store=args.store)
        
        if args.explain:
            for r in res[:args.top]:
                print(f"Producto: {r['product_name']}\nTienda: {r['store_name']}")
                print(r.get("reason", ""))
                print("-" * 40)
            return
            
        print_results(res[:args.top], format=args.format)

if __name__ == '__main__':
    main()
