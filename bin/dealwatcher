#!/data/data/com.termux/files/usr/bin/python3
import sys
import os

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../src')))

from dealhunter.alerts_engine import DealWatcher
from dealhunter.delivery import send_pending_events
import sqlite3

def run():
    db_path = os.path.expanduser("~/rappi-deal-hunter/rappi-deals.db")
    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    
    # Get latest completed or partial run
    c.execute("SELECT run_id FROM runs WHERE status IN ('COMPLETED', 'PARTIAL') ORDER BY started_at DESC LIMIT 1")
    row = c.fetchone()
    if not row:
        print("No completed runs found.")
        sys.exit(0)
        
    run_id = row[0]
    print(f"Processing run: {run_id}")
    
    watcher = DealWatcher(db_path)
    events = watcher.process_run(run_id)
    
    if events:
        inserted = watcher.persist_events(events)
        print(f"Inserted {inserted} new alert events.")
    else:
        print("No new events generated.")
        
    # Apply Watch and Delivery
    print("Applying Canary Watch and sending Termux notifications...")
    send_pending_events(db_path, limit=5, dry_run=False)
    print("Delivery pass completed.")

if __name__ == '__main__':
    run()
